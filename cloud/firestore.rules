rules_version = '2';

// Права Crosspect в Firestore. Проверяет сама база: что бы ни делал браузер,
// чужого не прочитать и не изменить. Модель данных и роли — docs/PLAN.md,
// раздел «Модель данных». Тесты — cloud/tests/rules.test.mjs (идут в CI).
//
// Коротко:
//   admins/{email}                   админы всей формы (этап 8). Пишет только служебный скрипт
//                                    (cloud/scripts/admin.mjs); человек видит только свою запись
//   spaces/{s}                       пространство (церковь). Создаёт и удаляет только
//                                    служебный скрипт, правит админ; список всех видит админ
//   spaces/{s}/members/{email}       участник и роль: editor | preacher (старая роль admin
//                                    участника считается редактором); добавляет и меняет админ
//   spaces/{s}/sermons/{id}          проповедь. Редактор и админ видят и правят всё,
//                                    проповедник правит свои, видит все (если пространство
//                                    разрешает) или только свои
//   spaces/{s}/sermons/{id}/editor/state   отметки редактора; проповедник их не видит
//   spaces/{s}/summaries/{id}        сводка проповеди для списка на главной (этап 8): пишется
//                                    в одной записи с проповедью и совпадает с ней
//   spaces/{s}/config/slides         настройки слайдов пространства: видят все, правят админ и редактор
//   people/{email}/prefs/screen      раскладка экрана у человека: видит и правит только он сам
//   shares/{key}                     снимок для оператора: читается по ключу без входа

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- кто спрашивает ----------

    // Вход через Google: почта есть и подтверждена.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }

    function spacePath(s) {
      return /databases/$(database)/documents/spaces/$(s);
    }
    function memberPath(s) {
      return /databases/$(database)/documents/spaces/$(s)/members/$(me());
    }
    function sermonPath(s, id) {
      return /databases/$(database)/documents/spaces/$(s)/sermons/$(id);
    }

    // Админ всей формы (этап 8): его почта лежит в admins/{email}. Видит все пространства
    // и в каждом может всё, что редактор, плюс название, настройки и участники.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(me()));
    }
    function hasRole(s, roles) {
      return signedIn() && exists(memberPath(s)) && get(memberPath(s)).data.role in roles;
    }
    // Роль admin у участника пространства — с этапа 8 просто редактор (перенос — admin.mjs migrate-8)
    function isMember(s)   { return isAdmin() || hasRole(s, ['admin', 'editor', 'preacher']); }
    function isEditor(s)   { return isAdmin() || hasRole(s, ['admin', 'editor']); }
    function isPreacher(s) { return !isAdmin() && hasRole(s, ['preacher']); }

    function spaceSettings(s) {
      return get(spacePath(s)).data.get('settings', {});
    }
    // Проповедники видят все проповеди пространства (по умолчанию да).
    function seeAll(s) {
      return spaceSettings(s).get('preachersSeeAll', true) == true;
    }
    // Сколько минут замок живёт после последнего сигнала «я здесь».
    function lockMinutes(s) {
      return spaceSettings(s).get('lockMinutes', 10);
    }

    // ---------- проверки полей ----------

    function str(v, max) {
      return v is string && v.size() <= max;
    }
    function optStr(m, k, max) {
      return !(k in m) || str(m[k], max);
    }
    function isEmail(v) {
      return str(v, 320) && v == v.lower() && v.matches('[^@/ ]+@[^@/ ]+');
    }

    // ---------- пространство ----------

    function validSpace(d) {
      return d.keys().hasAll(['name', 'settings'])
        && d.keys().hasOnly(['name', 'settings', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && str(d.name, 100) && d.name.size() > 0
        && d.settings is map
        && (!('lockMinutes' in d.settings)
            || (d.settings.lockMinutes is int && d.settings.lockMinutes >= 1 && d.settings.lockMinutes <= 120))
        && (!('preachersSeeAll' in d.settings) || d.settings.preachersSeeAll is bool);
    }

    // ---------- админы всей формы (этап 8) ----------
    // Человек узнаёт, админ ли он, читая свою запись. Записывает только служебный скрипт.
    match /admins/{email} {
      allow get: if signedIn() && email == me();
    }

    match /spaces/{s} {
      allow get: if isMember(s);
      // Список всех пространств — только админу; остальные находят свои через участников (ниже).
      allow list: if isAdmin();
      allow update: if isAdmin()
        && validSpace(request.resource.data)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == me();
      // create, delete — только служебным скриптом (у него права в обход правил).

      // ---------- участники ----------

      function validMember(email, d) {
        return d.keys().hasAll(['email', 'role'])
          && d.keys().hasOnly(['email', 'role', 'firstName', 'lastName', 'addedBy', 'addedAt'])
          && d.email == email && isEmail(email)
          && d.role in ['editor', 'preacher']
          && optStr(d, 'firstName', 100) && optStr(d, 'lastName', 100);
      }

      match /members/{email} {
        allow get: if isMember(s) || (signedIn() && email == me());
        allow list: if isMember(s);
        allow create: if isAdmin()
          && validMember(email, request.resource.data)
          && request.resource.data.addedBy == me()
          && request.resource.data.addedAt == request.time;
        // Админ правит всех. Каждый может поправить своё имя и фамилию.
        // Роль меняет только админ (старую роль admin у участника он может только заменить).
        allow update: if request.resource.data.get('addedBy', null) == resource.data.get('addedBy', null)
          && request.resource.data.get('addedAt', null) == resource.data.get('addedAt', null)
          && (isAdmin()
              ? validMember(email, request.resource.data)
              : (isMember(s) && email == me()
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName'])
                 && optStr(request.resource.data, 'firstName', 100) && optStr(request.resource.data, 'lastName', 100)));
        allow delete: if isAdmin();
      }

      // ---------- настройки слайдов (этап 7.1) ----------
      // config/slides — общие для всех проповедей пространства. Видят все участники (слайды рисует и спикер),
      // меняют админ и редактор. Удалить из браузера нельзя: форма только перезаписывает.
      match /config/{doc} {
        allow get: if isMember(s);
        allow create, update: if isEditor(s) && doc == 'slides'
          && request.resource.data.keys().hasAll(['slides', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasOnly(['slides', 'updatedAt', 'updatedBy'])
          && request.resource.data.slides is map
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me();
      }

      // ---------- проповеди ----------

      match /sermons/{id} {
        function canRead(d) {
          return isEditor(s) || (isPreacher(s) && (d.owner == me() || seeAll(s)));
        }
        // «У редактора» (этап 7.3): статус work (и старое done) — конспект взял редактор,
        // автор (проповедник) его не правит, не берёт замок, не меняет статус и не удаляет
        function atEditor(d) {
          return d.status in ['work', 'done'];
        }
        function canEdit(d) {
          return isEditor(s) || (isPreacher(s) && d.owner == me() && !atEditor(d));
        }
        function changed() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        // Замок: { email, name, at — когда взят, beat — последний сигнал «я здесь» }.
        // Время ставит сервер (serverTimestamp), подделать его нельзя.
        function lockShape(l) {
          return l == null
            || (l is map
                && l.keys().hasAll(['email', 'name', 'at', 'beat'])
                && l.keys().hasOnly(['email', 'name', 'at', 'beat'])
                && str(l.email, 320) && str(l.name, 200)
                && l.at is timestamp && l.beat is timestamp);
        }
        function lockLive(l) {
          return l != null && request.time < l.beat + duration.value(lockMinutes(s), 'm');
        }
        function lockMine(l) {
          return l != null && l.email == me();
        }
        // before — замок до записи, after — после.
        function lockOk(before, after, keys) {
          return (
              // замок свободен (нет или истёк) или он мой —
              (!lockLive(before) || lockMine(before))
              && (
                // отпустить
                after == null
                // взять или продлить: на себя, со временем сервера
                || (lockMine(after) && after.beat == request.time
                    && (after.at == request.time || (lockMine(before) && after.at == before.at)))
                // не трогать: только если замка нет или он мой
                || (after == before && (before == null || lockMine(before)))
              )
            )
            // редактор забирает чужой живой замок — отдельной записью, без правок
            || (isEditor(s) && lockLive(before) && !lockMine(before)
                && lockMine(after) && after.at == request.time && after.beat == request.time
                && keys.hasOnly(['lock']));
        }

        function validSermon(d) {
          return d.keys().hasAll(['v', 'meta', 'blocks', 'status', 'owner',
                                  'createdBy', 'createdAt', 'updatedAt', 'updatedBy'])
            && d.keys().hasOnly(['v', 'meta', 'settings', 'blocks', 'status', 'owner',
                                 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'lock', 'shareKey'])
            && d.v is int
            && d.meta is map
            && optStr(d.meta, 'title', 300) && optStr(d.meta, 'date', 20)
            && optStr(d.meta, 'firstName', 100) && optStr(d.meta, 'lastName', 100)
            && (!('settings' in d) || d.settings is map)
            && d.blocks is list && d.blocks.size() <= 500
            && d.status in ['draft', 'submitted', 'work', 'done']
            // owner — почта проповедника; пусто — гость без входа (такие заводит редактор)
            && (d.owner == '' || isEmail(d.owner))
            && lockShape(d.get('lock', null))
            // shareKey — ключ ссылки для оператора (этап 9). Длину ключа проверяет shares/{key};
            // здесь только «строка не длиннее 64»: каждая проверка в этом правиле считается в предел базы
            && (!('shareKey' in d) || d.shareKey == null || str(d.shareKey, 64));
        }

        allow get, list: if canRead(resource.data);

        allow create: if validSermon(request.resource.data)
          && request.resource.data.createdBy == me()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && (isEditor(s)
              || (isPreacher(s)
                  && request.resource.data.owner == me()
                  && request.resource.data.status in ['draft', 'submitted']))
          && lockOk(null, request.resource.data.get('lock', null), request.resource.data.keys());

        allow update: if canEdit(resource.data)
          && validSermon(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          // проповедник не отдаёт проповедь другому и сам ставит только «Черновик» / «Готов к вёрстке»
          // (одна проверка isEditor вместо двух: база считает все выражения запроса, предел — 1000)
          && (isEditor(s)
              || (request.resource.data.owner == resource.data.owner
                  && (request.resource.data.status == resource.data.status
                      || request.resource.data.status in ['draft', 'submitted'])))
          // правка содержимого отмечает, кто и когда; сигнал замка — нет
          && (changed().hasOnly(['lock'])
              || (request.resource.data.updatedAt == request.time
                  && request.resource.data.updatedBy == me()))
          && lockOk(resource.data.get('lock', null), request.resource.data.get('lock', null), changed());

        // Проповедник удаляет только свой черновик («У редактора» — тем более нет). Под чужим живым замком не удаляет никто.
        allow delete: if (isEditor(s)
              || (isPreacher(s) && resource.data.owner == me() && resource.data.status == 'draft'))
          && (!lockLive(resource.data.get('lock', null)) || lockMine(resource.data.get('lock', null)));

        // ---------- отметки редактора («доработать» и т. п.) ----------

        match /editor/{doc} {
          allow get, list: if isEditor(s);
          allow create, update: if isEditor(s) && doc == 'state'
            && request.resource.data.keys().hasOnly(['flags', 'updatedAt', 'updatedBy'])
            && request.resource.data.get('flags', {}) is map
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == me();
          // вместе с проповедью их может удалить и тот, кто удаляет проповедь
          allow delete: if isEditor(s) || (isMember(s) && !existsAfter(sermonPath(s, id)));
        }
      }

      // ---------- сводки для списка на главной (этап 8) ----------
      // summaries/{id} — маленькая копия того, что нужно карточке: название, дата, автор, статус, хозяин,
      // время правки, замок, число слайдов и места Писания для поиска. Форма пишет её в той же записи
      // (транзакции или пачке), что и саму проповедь. База проверяет, что сводка совпадает с проповедью
      // после записи и что проповедь в этой же записи изменилась (или удалена).
      match /summaries/{id} {
        function after() { return getAfter(sermonPath(s, id)).data; }
        function validSummary(d, p) {
          return d.keys().hasAll(['title', 'date', 'firstName', 'lastName', 'status', 'owner',
                                  'updatedAt', 'updatedBy', 'lock', 'slides', 'refs'])
            && d.keys().hasOnly(['title', 'date', 'firstName', 'lastName', 'status', 'owner',
                                 'updatedAt', 'updatedBy', 'lock', 'slides', 'refs'])
            && d.title == p.meta.get('title', '') && d.date == p.meta.get('date', '')
            && d.firstName == p.meta.get('firstName', '') && d.lastName == p.meta.get('lastName', '')
            && d.status == p.status && d.owner == p.owner
            && d.updatedAt == p.updatedAt && d.updatedBy == p.updatedBy
            && d.lock == p.get('lock', null)
            && d.slides is int && d.slides >= 0 && d.slides <= 500
            && str(d.refs, 2000);
        }
        // проповедь меняется в этой же записи: появилась, сменились время правки или замок
        function sermonWritten() {
          return !exists(sermonPath(s, id))
            || get(sermonPath(s, id)).data.updatedAt != after().updatedAt
            || get(sermonPath(s, id)).data.get('lock', null) != after().get('lock', null);
        }
        allow get, list: if isEditor(s)
          || (isPreacher(s) && (resource.data.owner == me() || seeAll(s)));
        allow create, update: if isMember(s)
          && existsAfter(sermonPath(s, id))
          && sermonWritten()
          && validSummary(request.resource.data, after());
        allow delete: if isMember(s) && !existsAfter(sermonPath(s, id));
      }
    }

    // ---------- личные настройки экрана (этап 7.2) ----------
    // people/{email}/prefs/screen — ширина и порядок панелей у человека, общие для всех его пространств.
    // Читает и пишет только сам человек. Удалить из браузера нельзя: «Сбросить» записывает пустую раскладку.
    match /people/{email}/prefs/{doc} {
      allow get: if signedIn() && email == me();
      allow create, update: if signedIn() && email == me() && doc == 'screen'
        && request.resource.data.keys().hasAll(['layout', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['layout', 'updatedAt'])
        && request.resource.data.layout is map
        && request.resource.data.layout.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }

    // Свои пространства: запрос по всем «members» с условием email == моя почта.
    match /{path=**}/members/{email} {
      allow list: if signedIn() && resource.data.email == me();
    }

    // ---------- ссылка для оператора ----------

    function canEditSermon(s, id) {
      return isEditor(s) || (isPreacher(s) && get(sermonPath(s, id)).data.owner == me());
    }
    function validShare(d) {
      return d.keys().hasAll(['spaceId', 'sermonId', 'sermon', 'createdBy', 'updatedAt'])
        && d.keys().hasOnly(['spaceId', 'sermonId', 'sermon', 'createdBy', 'updatedAt'])
        && str(d.spaceId, 100) && str(d.sermonId, 100)
        && d.sermon is map
        && d.updatedAt == request.time;
    }

    match /shares/{key} {
      // по ключу читает кто угодно, даже без входа; перебрать все ссылки нельзя
      allow get: if true;
      allow create: if signedIn()
        && key.size() >= 20 && key.size() <= 64
        && validShare(request.resource.data)
        && request.resource.data.createdBy == me()
        && canEditSermon(request.resource.data.spaceId, request.resource.data.sermonId);
      allow update: if signedIn()
        && validShare(request.resource.data)
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.sermonId == resource.data.sermonId
        && request.resource.data.createdBy == resource.data.createdBy
        && canEditSermon(resource.data.spaceId, resource.data.sermonId);
      allow delete: if signedIn() && canEditSermon(resource.data.spaceId, resource.data.sermonId);
    }
  }
}
