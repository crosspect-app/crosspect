rules_version = '2';

// Права Crosspect в Firestore. Проверяет сама база: что бы ни делал браузер,
// чужого не прочитать и не изменить. Модель данных и роли — docs/PLAN.md,
// раздел «Модель данных». Тесты — cloud/tests/rules.test.mjs (идут в CI).
//
// Коротко:
//   admins/{email}                   админы всей формы (этап 8). Пишет только служебный скрипт
//                                    (cloud/scripts/admin.mjs); человек видит только свою запись
//   spaces/{s}                       пространство (церковь). Создаёт, правит и удаляет (с этапа 10.1.2) админ
//                                    в форме; список всех видит админ
//   spaces/{s}/members/{key}         человек и роль: editor | preacher | operator (старая роль admin
//                                    участника считается редактором). key — почта (с ней человек входит в форму)
//                                    или p-<случайный> (без почты, этап 10.1.2). Оператор в форму не входит.
//                                    Добавляют, меняют и убирают админ и редактор (этап 10.1.2); tg — имя
//                                    пользователя Telegram; seenAt — последний вход, пишет сам человек
//   spaces/{s}/sermons/{id}          проповедь. Редактор и админ видят и правят всё,
//                                    проповедник правит свои, видит все (если пространство
//                                    разрешает) или только свои. Корзина (этап 9.1): удалённая
//                                    проповедь помечена deletedAt / deletedBy и не правится;
//                                    стереть насовсем можно только её
//   spaces/{s}/sermons/{id}/editor/state   отметки редактора; с этапа 9.7 их видит и автор, пишут редактор и админ
//   spaces/{s}/sermons/{id}/versions/{v}   история сохранений (этап 9.7): копии конспекта по «Сохранить», последние 10;
//                                    видят и пишут те, кто может править проповедь
//   spaces/{s}/summaries/{id}        сводка проповеди для списка на главной (этап 8): пишется
//                                    в одной записи с проповедью и совпадает с ней
//   spaces/{s}/config/slides         настройки слайдов пространства: видят все, правят админ и редактор
//   spaces/{s}/config/series         серии проповедей (этап 10): видят все, правят админ и редактор
//   spaces/{s}/config/operators      операторы этапа 10.1; с этапа 10.1.2 — люди с ролью operator. Форма переносит
//                                    их в members и удаляет документ; писать сюда больше нельзя
//   people/{email}/prefs/screen      раскладка экрана у человека: видит и правит только он сам
//   shares/{key}                     снимок для оператора: читается по ключу без входа
//   authors/{id}                     фотобанк этапа 10.5: правки описаний и вид по умолчанию. С этапа 10.5.2 форма их
//                                    не читает: скрипт cloud/scripts/photobank.mjs переносит их в bankPeople / bankPhotos
//   bankPeople/{id}                  фотобанк (этап 10.5.2): человек — имя, фамилия, подпись, другие написания
//   bankPhotos/{id}                  фото человека: без фона (cut) или с фоном (bg), размеры, порядок, вид по умолчанию,
//                                    миниатюра (bytes ≤ 40 КБ)
//   bankFiles/{id}                   картинка фото (bytes ≤ 900 КБ), отдельно от списка. Фотобанк общий для всех
//                                    пространств: читает любой, кто вошёл, пишет и удаляет только админ всей формы

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- кто спрашивает ----------

    // Вход через Google: почта есть и подтверждена.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }

    function spacePath(s) {
      return /databases/$(database)/documents/spaces/$(s);
    }
    function memberPath(s) {
      return /databases/$(database)/documents/spaces/$(s)/members/$(me());
    }
    function sermonPath(s, id) {
      return /databases/$(database)/documents/spaces/$(s)/sermons/$(id);
    }

    // Админ всей формы (этап 8): его почта лежит в admins/{email}. Видит все пространства
    // и в каждом может всё, что редактор, плюс название, настройки и участники.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(me()));
    }
    function hasRole(s, roles) {
      return signedIn() && exists(memberPath(s)) && get(memberPath(s)).data.role in roles;
    }
    // Роль admin у участника пространства — с этапа 8 просто редактор (перенос — admin.mjs migrate-8)
    function isMember(s)   { return isAdmin() || hasRole(s, ['admin', 'editor', 'preacher']); }
    function isEditor(s)   { return isAdmin() || hasRole(s, ['admin', 'editor']); }
    function isPreacher(s) { return !isAdmin() && hasRole(s, ['preacher']); }

    function spaceSettings(s) {
      return get(spacePath(s)).data.get('settings', {});
    }
    // Проповедники видят все проповеди пространства (по умолчанию да).
    function seeAll(s) {
      return spaceSettings(s).get('preachersSeeAll', true) == true;
    }
    // Сколько минут замок живёт после последнего сигнала «я здесь».
    function lockMinutes(s) {
      return spaceSettings(s).get('lockMinutes', 10);
    }

    // ---------- проверки полей ----------

    function str(v, max) {
      return v is string && v.size() <= max;
    }
    function optStr(m, k, max) {
      return !(k in m) || str(m[k], max);
    }
    function isEmail(v) {
      return str(v, 320) && v == v.lower() && v.matches('[^@/ ]+@[^@/ ]+');
    }
    // Имя пользователя Telegram без «@» (этап 10.1): латиница, цифры и «_», 5–32 знака, с буквы
    function isTg(v) {
      return v is string && v.matches('[A-Za-z][A-Za-z0-9_]{4,31}');
    }

    // ---------- пространство ----------

    function validSpace(d) {
      return d.keys().hasAll(['name', 'settings'])
        && d.keys().hasOnly(['name', 'settings', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && str(d.name, 100) && d.name.size() > 0
        && d.settings is map
        && (!('lockMinutes' in d.settings)
            || (d.settings.lockMinutes is int && d.settings.lockMinutes >= 1 && d.settings.lockMinutes <= 120))
        && (!('preachersSeeAll' in d.settings) || d.settings.preachersSeeAll is bool);
    }

    // ---------- админы всей формы (этап 8) ----------
    // Человек узнаёт, админ ли он, читая свою запись. Записывает только служебный скрипт.
    match /admins/{email} {
      allow get: if signedIn() && email == me();
    }

    // ---------- лимиты базы (этап 10.5.4) ----------
    // usage/current — счётчики из Cloud Monitoring. Пишет только служебный скрипт (в обход правил), читает только админ.
    match /usage/{id} {
      allow get: if isAdmin();
    }

    match /spaces/{s} {
      allow get: if isMember(s);
      // Список всех пространств — только админу; остальные находят свои через участников (ниже).
      allow list: if isAdmin();
      allow update: if isAdmin()
        && validSpace(request.resource.data)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == me();
      // Новое пространство (этап 10) заводит админ в форме: id случайный, время ставит сервер.
      allow create: if isAdmin()
        && validSpace(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == me()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == me();
      // Удаляет админ (этап 10.1.2): форма пускает только пустое пространство (ни конспектов, ни корзины)
      // и удаляет вместе с ним людей, настройки и сводки. Пустоту база проверить не может — это делает форма.
      allow delete: if isAdmin();

      // ---------- участники ----------

      // Человек (этап 10.1.2): с почтой — ключ и есть почта; без почты — ключ p-<случайный>, поля email нет.
      // Почта в ключе не может совпасть с p-ключом (в нём нет «@»), поэтому доступ по-прежнему ищет members/{почта}.
      function validMember(key, d) {
        return d.keys().hasAll(['role'])
          && d.keys().hasOnly(['email', 'role', 'firstName', 'lastName', 'tg', 'addedBy', 'addedAt', 'seenAt'])
          && (('email' in d) ? (d.email == key && isEmail(key)) : key.matches('p-[a-z0-9]{6,24}'))
          && d.role in ['editor', 'preacher', 'operator']
          && optStr(d, 'firstName', 100) && optStr(d, 'lastName', 100)
          && (!('tg' in d) || isTg(d.tg));
      }
      // seenAt: «последний вход» в таблице людей. Ставит сам человек при каждом входе, время — сервера.
      // Админ и редактор его не подделывают: оставляют как было.
      function seenOk(key) {
        return request.resource.data.get('seenAt', null) == resource.data.get('seenAt', null)
          || (key == me() && request.resource.data.seenAt == request.time);
      }

      match /members/{key} {
        allow get: if isMember(s) || (signedIn() && key == me());
        allow list: if isMember(s);
        allow create: if isEditor(s)
          && validMember(key, request.resource.data)
          && !('seenAt' in request.resource.data)
          && request.resource.data.addedBy == me()
          && request.resource.data.addedAt == request.time;
        // Админ и редактор правят всех (роль — только editor, preacher или operator). Каждый участник может поправить
        // своё имя и фамилию и отметить вход (seenAt); так и со старой ролью admin, которую validMember не пропустит.
        allow update: if request.resource.data.get('addedBy', null) == resource.data.get('addedBy', null)
          && request.resource.data.get('addedAt', null) == resource.data.get('addedAt', null)
          && seenOk(key)
          && ((isMember(s) && key == me()
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'seenAt'])
               && optStr(request.resource.data, 'firstName', 100) && optStr(request.resource.data, 'lastName', 100))
              || (isEditor(s) && validMember(key, request.resource.data)));
        allow delete: if isEditor(s);
      }

      // ---------- настройки слайдов (этап 7.1) и серии проповедей (этап 10) ----------
      // config/slides — общие для всех проповедей пространства. Видят все участники (слайды рисует и спикер),
      // меняют админ и редактор. config/series — серии { <id>: { name, active, format } }: автор видит их,
      // чтобы выбрать серию в «О проповеди»; меняют админ и редактор. Удаляет их только админ — вместе с пространством.
      // config/operators (этап 10.1) — только прочитать и удалить: форма переносит операторов в людей (этап 10.1.2).
      match /config/{doc} {
        allow get: if isMember(s);
        allow create, update: if isEditor(s) && doc in ['slides', 'series']
          && request.resource.data.keys().hasAll([doc, 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasOnly([doc, 'updatedAt', 'updatedBy'])
          && request.resource.data[doc] is map
          && request.resource.data[doc].size() <= 300
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me();
        allow delete: if isAdmin() || (isEditor(s) && doc == 'operators');
      }

      // ---------- проповеди ----------

      match /sermons/{id} {
        function canRead(d) {
          return isEditor(s) || (isPreacher(s) && (d.owner == me() || seeAll(s)));
        }
        // «У редактора» (этап 7.3): статус work (и старое done) — конспект взял редактор,
        // автор (проповедник) его не правит, не берёт замок, не меняет статус и не удаляет.
        // «Презентация готова» (ready, этап 9.7) — то же самое
        function atEditor(d) {
          return d.status in ['work', 'done', 'ready'];
        }
        // в корзине (этап 9.1) автор не правит и в обход «Восстановить» (снять пометку правкой);
        // редактору проверка не нужна: восстановить он может и так
        function canEdit(d) {
          return isEditor(s) || (isPreacher(s) && d.owner == me() && !atEditor(d) && !('deletedAt' in d));
        }
        // Корзина (этап 9.1): кто убирает в корзину, восстанавливает и стирает насовсем — как прежде удаление:
        // редактор и админ — любую, автор — свой черновик
        function canTrash(d) {
          return isEditor(s) || (isPreacher(s) && d.owner == me() && d.status == 'draft');
        }
        function changed() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        // Замок: { email, name, at — когда взят, beat — последний сигнал «я здесь» }.
        // Время ставит сервер (serverTimestamp), подделать его нельзя.
        function lockShape(l) {
          return l == null
            || (l is map
                && l.keys().hasAll(['email', 'name', 'at', 'beat'])
                && l.keys().hasOnly(['email', 'name', 'at', 'beat'])
                && str(l.email, 320) && str(l.name, 200)
                && l.at is timestamp && l.beat is timestamp);
        }
        function lockLive(l) {
          return l != null && request.time < l.beat + duration.value(lockMinutes(s), 'm');
        }
        function lockMine(l) {
          return l != null && l.email == me();
        }
        // before — замок до записи, after — после.
        function lockOk(before, after, keys) {
          return (
              // замок свободен (нет или истёк) или он мой —
              (!lockLive(before) || lockMine(before))
              && (
                // отпустить
                after == null
                // взять или продлить: на себя, со временем сервера
                || (lockMine(after) && after.beat == request.time
                    && (after.at == request.time || (lockMine(before) && after.at == before.at)))
                // не трогать: только если замка нет или он мой
                || (after == before && (before == null || lockMine(before)))
              )
            )
            // редактор забирает чужой живой замок — отдельной записью, без правок
            || (isEditor(s) && lockLive(before) && !lockMine(before)
                && lockMine(after) && after.at == request.time && after.beat == request.time
                && keys.hasOnly(['lock']));
        }

        function validSermon(d) {
          return d.keys().hasAll(['v', 'meta', 'blocks', 'status', 'owner',
                                  'createdBy', 'createdAt', 'updatedAt', 'updatedBy'])
            && d.keys().hasOnly(['v', 'meta', 'settings', 'blocks', 'status', 'owner',
                                 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'lock', 'shareKey'])
            && d.v is int
            && d.meta is map
            && optStr(d.meta, 'title', 300) && optStr(d.meta, 'date', 20)
            && optStr(d.meta, 'firstName', 100) && optStr(d.meta, 'lastName', 100)
            // серия и свой формат фона (этап 10) — id из config/series и форматов; пишет и автор
            && optStr(d.meta, 'series', 64) && optStr(d.meta, 'format', 64)
            && (!('settings' in d) || d.settings is map)
            && d.blocks is list && d.blocks.size() <= 500
            && d.status in ['draft', 'submitted', 'work', 'done', 'ready']
            // owner — почта проповедника; пусто — гость без входа (такие заводит редактор)
            && (d.owner == '' || isEmail(d.owner))
            && lockShape(d.get('lock', null))
            // shareKey — ключ ссылки для оператора (этап 9). Длину ключа проверяет shares/{key};
            // здесь только «строка не длиннее 64»: каждая проверка в этом правиле считается в предел базы
            && (!('shareKey' in d) || d.shareKey == null || str(d.shareKey, 64));
        }

        allow get, list: if canRead(resource.data);

        allow create: if validSermon(request.resource.data)
          && request.resource.data.createdBy == me()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == me()
          && (isEditor(s)
              || (isPreacher(s)
                  && request.resource.data.owner == me()
                  && request.resource.data.status in ['draft', 'submitted']))
          && lockOk(null, request.resource.data.get('lock', null), request.resource.data.keys());

        // В корзину и обратно — отдельной записью: меняются только пометки (и замок снимается).
        // Стоит первой: у обычной правки первое же условие ложно, и она почти ничего не тратит из предела вычислений.
        // Остальная правка проповеди в корзине невозможна: validSermon не знает deletedAt / deletedBy.
        function trashMove() {
          return changed().hasOnly(['deletedAt', 'deletedBy', 'lock'])
            && changed().hasAny(['deletedAt'])   // сигнал и отпускание замка сюда не попадают
            && canTrash(resource.data)
            && request.resource.data.get('lock', null) == null
            && (('deletedAt' in resource.data)
                // из корзины: пометки уходят
                ? (!('deletedAt' in request.resource.data) && !('deletedBy' in request.resource.data))
                // в корзину: когда (время сервера) и кто; под чужим живым замком — нельзя
                : (request.resource.data.deletedAt == request.time
                   && request.resource.data.deletedBy == me()
                   && (!lockLive(resource.data.get('lock', null)) || lockMine(resource.data.get('lock', null)))));
        }

        allow update: if trashMove() || (canEdit(resource.data)
          && validSermon(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          // проповедник не отдаёт проповедь другому и сам ставит только «Черновик» / «Готов к вёрстке»
          // (одна проверка isEditor вместо двух: база считает все выражения запроса, предел — 1000)
          && (isEditor(s)
              || (request.resource.data.owner == resource.data.owner
                  && (request.resource.data.status == resource.data.status
                      || request.resource.data.status in ['draft', 'submitted'])))
          // правка содержимого отмечает, кто и когда; сигнал замка — нет
          && (changed().hasOnly(['lock'])
              || (request.resource.data.updatedAt == request.time
                  && request.resource.data.updatedBy == me()))
          && lockOk(resource.data.get('lock', null), request.resource.data.get('lock', null), changed()));

        // Стереть насовсем (этап 9.1) — только из корзины; кто может — как с корзиной (автор — свой черновик).
        // Замка в корзине нет: его снимает перенос в корзину. Через 30 дней корзину чистит служебный скрипт.
        allow delete: if ('deletedAt' in resource.data) && canTrash(resource.data);

        // ---------- отметки редактора («доработать» и т. п.) ----------

        // Видят все, кто видит проповедь (этап 9.7: автор тоже видит «доработать»); пишут редактор и админ
        match /editor/{doc} {
          allow get, list: if isEditor(s) || canRead(get(sermonPath(s, id)).data);
          allow create, update: if isEditor(s) && doc == 'state'
            && request.resource.data.keys().hasOnly(['flags', 'updatedAt', 'updatedBy'])
            && request.resource.data.get('flags', {}) is map
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == me();
          // вместе с проповедью их может удалить и тот, кто удаляет проповедь
          allow delete: if isEditor(s) || (isMember(s) && !existsAfter(sermonPath(s, id)));
        }

        // ---------- история сохранений (этап 9.7) ----------
        // versions/{v} — копия конспекта на момент «Сохранить»: { v, meta, settings, blocks, status, savedAt, savedBy, name }.
        // Видят и пишут те, кто может править проповедь (автор — свою, пока она не у редактора и не в корзине;
        // из корзины — ещё и тот, кто может стереть её насовсем, чтобы стереть и историю). Менять копию нельзя:
        // только добавить новую и удалить лишние (форма держит последние 10).
        match /versions/{v} {
          function owner() { return get(sermonPath(s, id)).data; }
          function validVersion(d) {
            return d.keys().hasAll(['v', 'meta', 'blocks', 'status', 'savedAt', 'savedBy'])
              && d.keys().hasOnly(['v', 'meta', 'settings', 'blocks', 'status', 'savedAt', 'savedBy', 'name'])
              && d.v is int && d.meta is map
              && (!('settings' in d) || d.settings is map)
              && d.blocks is list && d.blocks.size() <= 500
              && d.status is string && d.status.size() <= 20
              && d.savedAt == request.time && d.savedBy == me()
              && optStr(d, 'name', 200);
          }
          allow get, list: if canEdit(owner()) || (('deletedAt' in owner()) && canTrash(owner()));
          allow create: if exists(sermonPath(s, id)) && canEdit(owner()) && validVersion(request.resource.data);   // без проповеди истории нет (редактору get не понадобился бы)
          allow delete: if (exists(sermonPath(s, id)) && (canEdit(owner()) || (('deletedAt' in owner()) && canTrash(owner()))))
            || (isMember(s) && !existsAfter(sermonPath(s, id)));
        }
      }

      // ---------- сводки для списка на главной (этап 8) ----------
      // summaries/{id} — маленькая копия того, что нужно карточке: название, дата, автор, статус, хозяин,
      // время правки, замок, число слайдов и места Писания для поиска. Форма пишет её в той же записи
      // (транзакции или пачке), что и саму проповедь. База проверяет, что сводка совпадает с проповедью
      // после записи и что проповедь в этой же записи изменилась (или удалена).
      match /summaries/{id} {
        function after() { return getAfter(sermonPath(s, id)).data; }
        function validSummary(d, p) {
          return d.keys().hasAll(['title', 'date', 'firstName', 'lastName', 'status', 'owner',
                                  'updatedAt', 'updatedBy', 'lock', 'slides', 'refs'])
            && d.keys().hasOnly(['title', 'date', 'firstName', 'lastName', 'status', 'owner',
                                 'updatedAt', 'updatedBy', 'lock', 'slides', 'refs', 'deletedAt', 'deletedBy', 'series'])
            && d.title == p.meta.get('title', '') && d.date == p.meta.get('date', '')
            && d.firstName == p.meta.get('firstName', '') && d.lastName == p.meta.get('lastName', '')
            && d.get('series', '') == p.meta.get('series', '')   // серия (этап 10), для колонки и фильтра
            && d.status == p.status && d.owner == p.owner
            && d.updatedAt == p.updatedAt && d.updatedBy == p.updatedBy
            && d.lock == p.get('lock', null)
            // корзина (этап 9.1): пометки — как у проповеди
            && d.get('deletedAt', null) == p.get('deletedAt', null) && d.get('deletedBy', null) == p.get('deletedBy', null)
            && d.slides is int && d.slides >= 0 && d.slides <= 500
            && str(d.refs, 2000);
        }
        // проповедь меняется в этой же записи: появилась, сменились время правки, замок или пометка корзины
        function sermonWritten() {
          return !exists(sermonPath(s, id))
            || get(sermonPath(s, id)).data.updatedAt != after().updatedAt
            || get(sermonPath(s, id)).data.get('lock', null) != after().get('lock', null)
            || get(sermonPath(s, id)).data.get('deletedAt', null) != after().get('deletedAt', null);
        }
        allow get, list: if isEditor(s)
          || (isPreacher(s) && (resource.data.owner == me() || seeAll(s)));
        allow create, update: if isMember(s)
          && existsAfter(sermonPath(s, id))
          && sermonWritten()
          && validSummary(request.resource.data, after());
        allow delete: if isMember(s) && !existsAfter(sermonPath(s, id));
      }
    }

    // ---------- личные настройки экрана (этап 7.2) ----------
    // people/{email}/prefs/screen — ширина и порядок панелей у человека, общие для всех его пространств.
    // Читает и пишет только сам человек. Удалить из браузера нельзя: «Сбросить» записывает пустую раскладку.
    match /people/{email}/prefs/{doc} {
      allow get: if signedIn() && email == me();
      allow create, update: if signedIn() && email == me() && doc == 'screen'
        && request.resource.data.keys().hasAll(['layout', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['layout', 'updatedAt'])
        && request.resource.data.layout is map
        && request.resource.data.layout.size() <= 20
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- фотобанк (этап 10.5) ----------
    // Картинки и начальные описания — в репозитории (img/authors/). Здесь — правки описаний и вид фото по умолчанию
    // (preset: положение и размер в долях слайда, сторона фото, фильтр, отражение и — с этапа 10.5.3 — обрезка, поворот, обводка, углы). Общие для всех пространств.
    function validPresetCrop(c) {
      return c is map
        && c.keys().hasOnly(['l', 't', 'r', 'b'])
        && c.keys().hasAll(['l', 't', 'r', 'b'])
        && c.l is number && c.l >= 0 && c.l <= 0.9
        && c.t is number && c.t >= 0 && c.t <= 0.9
        && c.r is number && c.r >= 0 && c.r <= 0.9
        && c.b is number && c.b >= 0 && c.b <= 0.9
        && c.l + c.r <= 0.9 && c.t + c.b <= 0.9;
    }
    function validPresetOutline(o) {
      return o is map
        && o.keys().hasOnly(['w', 'color'])
        && o.keys().hasAll(['w', 'color'])
        && o.w is number && o.w >= 0 && o.w <= 30
        && o.color is string && o.color.matches('^#[0-9a-fA-F]{6}$');
    }
    function validPreset(p) {
      return p is map
        && p.keys().hasAll(['x', 'y', 'h', 'side', 'filter', 'mirror'])
        && p.keys().hasOnly(['x', 'y', 'h', 'side', 'filter', 'mirror', 'crop', 'rot', 'outline', 'round'])
        && p.x is number && p.x >= -2 && p.x <= 3
        && p.y is number && p.y >= -2 && p.y <= 4
        && p.h is number && p.h >= 0.15 && p.h <= 3
        && p.side in ['left', 'right']
        && p.filter in ['none', 'bw', 'bwHard', 'bwSoft', 'sepia', 'warm', 'cool', 'muted', 'tone']
        && p.mirror is bool
        // этап 10.5.3: обрезка (доли картинки), поворот (градусы), обводка (px слайда), скругление углов — необязательные
        && (!('crop' in p) || validPresetCrop(p.crop))
        && (!('rot' in p) || (p.rot is number && p.rot >= -180 && p.rot <= 180))
        && (!('outline' in p) || validPresetOutline(p.outline))
        && (!('round' in p) || (p.round is number && p.round >= 0 && p.round <= 0.5));
    }
    function validAuthor(d) {
      return d.keys().hasAll(['updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['first', 'last', 'caption', 'aliases', 'preset', 'updatedAt', 'updatedBy'])
        && optStr(d, 'first', 100) && optStr(d, 'last', 100) && optStr(d, 'caption', 200)
        && (!('aliases' in d) || (d.aliases is list && d.aliases.size() <= 20))
        && (!('preset' in d) || validPreset(d.preset))
        && d.updatedAt == request.time
        && d.updatedBy == me();
    }
    match /authors/{id} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin() && id.matches('[a-z0-9-]{1,60}') && validAuthor(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- фотобанк (этап 10.5.2) ----------
    // Люди и их фото, картинки — прямо в базе (поле bytes), без платного хранилища. Картинка не меняется: новое фото — новый id.
    function bankStamp(d) {
      return d.updatedAt == request.time && d.updatedBy == me();
    }
    function validBankPerson(d) {
      return d.keys().hasAll(['updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['first', 'last', 'caption', 'aliases', 'updatedAt', 'updatedBy'])
        && optStr(d, 'first', 100) && optStr(d, 'last', 100) && optStr(d, 'caption', 200)
        && (!('aliases' in d) || (d.aliases is list && d.aliases.size() <= 20))
        && bankStamp(d);
    }
    function validBankPhoto(d) {
      return d.keys().hasAll(['person', 'kind', 'w', 'h', 'order', 'thumb', 'updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['person', 'kind', 'faces', 'w', 'h', 'order', 'source', 'preset', 'thumb', 'updatedAt', 'updatedBy'])
        && d.person is string && d.person.matches('[a-z0-9-]{1,60}')
        && ((d.kind == 'cut' && d.faces in ['right', 'front']) || (d.kind == 'bg' && !('faces' in d)))
        && d.w is int && d.w > 0 && d.w <= 4000
        && d.h is int && d.h > 0 && d.h <= 4000
        && d.order is int && d.order >= 0 && d.order <= 10000
        && optStr(d, 'source', 300)
        && (!('preset' in d) || validPreset(d.preset))
        && d.thumb is bytes && d.thumb.size() <= 40960
        && bankStamp(d);
    }
    match /bankPeople/{id} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin() && id.matches('[a-z0-9-]{1,60}') && validBankPerson(request.resource.data);
      allow delete: if isAdmin();
    }
    match /bankPhotos/{id} {
      allow get, list: if signedIn();
      allow create: if isAdmin() && id.matches('[a-z0-9-]{1,60}') && validBankPhoto(request.resource.data)
        && existsAfter(/databases/$(database)/documents/bankPeople/$(request.resource.data.person))
        && existsAfter(/databases/$(database)/documents/bankFiles/$(id));
      // после загрузки меняются только порядок, вид по умолчанию и источник
      allow update: if isAdmin() && validBankPhoto(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['order', 'preset', 'source', 'updatedAt', 'updatedBy']);
      allow delete: if isAdmin();
    }
    match /bankFiles/{id} {
      allow get: if signedIn();
      allow create: if isAdmin() && id.matches('[a-z0-9-]{1,60}')
        && request.resource.data.keys().hasOnly(['img', 'updatedAt', 'updatedBy'])
        && request.resource.data.img is bytes && request.resource.data.img.size() <= 921600
        && bankStamp(request.resource.data)
        && existsAfter(/databases/$(database)/documents/bankPhotos/$(id));
      allow delete: if isAdmin();
    }

    // Свои пространства: запрос по всем «members» с условием email == моя почта.
    match /{path=**}/members/{email} {
      allow list: if signedIn() && resource.data.email == me();
    }

    // ---------- ссылка для оператора ----------

    function canEditSermon(s, id) {
      return isEditor(s) || (isPreacher(s) && get(sermonPath(s, id)).data.owner == me());
    }
    function validShare(d) {
      return d.keys().hasAll(['spaceId', 'sermonId', 'sermon', 'createdBy', 'updatedAt'])
        && d.keys().hasOnly(['spaceId', 'sermonId', 'sermon', 'createdBy', 'updatedAt'])
        && str(d.spaceId, 100) && str(d.sermonId, 100)
        && d.sermon is map
        && d.updatedAt == request.time;
    }

    match /shares/{key} {
      // по ключу читает кто угодно, даже без входа; перебрать все ссылки нельзя
      allow get: if true;
      allow create: if signedIn()
        && key.size() >= 20 && key.size() <= 64
        && validShare(request.resource.data)
        && request.resource.data.createdBy == me()
        && canEditSermon(request.resource.data.spaceId, request.resource.data.sermonId);
      allow update: if signedIn()
        && validShare(request.resource.data)
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.sermonId == resource.data.sermonId
        && request.resource.data.createdBy == resource.data.createdBy
        && canEditSermon(resource.data.spaceId, resource.data.sermonId);
      allow delete: if signedIn() && canEditSermon(resource.data.spaceId, resource.data.sermonId);
    }
  }
}
